QQ_APP_ID=replace-with-your-app-id
QQ_APP_SECRET=replace-with-your-app-secret
QQ_BOT_TOKEN=replace-with-your-bot-token
# Empty accepts commands from every group with QQ full-message delivery enabled.
QQ_GROUP_WHITELIST=
QQ_INTENTS=33554432
QQ_OFFICIAL_WS_ENABLED=0
QQ_BRIDGE_ENABLED=1
QQ_WEBHOOK_PATH=/qq
# 1 = ack QQ callbacks at once and process in the background; 0 = old behaviour (reply after processing)
QQ_WEBHOOK_ASYNC=1
# /bindqq proof of ownership: email = code mailed to <qq>@qq.com, off = no check
QQ_BIND_VERIFY=off

AI_BASE_URL=https://api.example.com/v1
AI_MODEL=deepseek-v4-flash
AI_API_KEY=replace-with-ai-api-key

IMAGE_AI_ENABLED=0
IMAGE_AI_BASE_URL=https://example.com/v1
IMAGE_AI_API_KEY=replace-with-image-ai-api-key
IMAGE_AI_MODEL=grok-imagine-1.0-fast
IMAGE_AI_SIZE=1024x1024
IMAGE_AI_COOLDOWN_SECONDS=60

# Secrets that must never be committed (this file is root-only on the server)
BOT_ADMIN_SECRET=replace-with-admin-passphrase
SAUTH_BASE_URL=https://inventory.example.com
SAUTH_API_KEY=replace-with-inventory-api-key
SAUTH_ADMIN_TOKEN=replace-with-inventory-admin-token
NFA_BASE_URL=http://nfa.example.com:3000
NFA_USERNAME=replace-with-nfa-user
NFA_PASSWORD=replace-with-nfa-password

DATABASE_URL=sqlite:////opt/official_qqbot/data/control.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg://qqbot:<password>@127.0.0.1:<port>/qqbot
# Delete command/outbound logs older than N days (0 = keep everything)
CONTROL_LOG_RETENTION_DAYS=0
CONTROL_API_BASE_URL=http://127.0.0.1:9000
BOT_CONTROL_TOKEN=replace-with-bot-token
ADMIN_CONTROL_TOKEN=replace-with-admin-control-token
DASHBOARD_SESSION_SECRET=replace-with-long-random-session-secret
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=9000
QQ_WEBHOOK_FORWARD_URL=http://127.0.0.1:8765/qq
